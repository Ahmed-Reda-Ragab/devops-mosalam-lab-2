# ============================================================================
#  Database secrets — the replacement for the Docker secrets in
#  compose/docker-compose.database.yml (secrets/* files on the host).
#
#  ⚠️  DO NOT COMMIT A FILLED-IN COPY OF THIS FILE.
#      The `.example` suffix is what keeps it out of Argo CD's directory sync
#      (Argo only picks up *.yaml / *.yml / *.json).
#
#  --------------------------------------------------------------------------
#  Option A — quick start (create it out-of-band, never in git):
#
#    kubectl -n tasks-db create secret generic mysql-secrets \
#      --from-file=mysql_root_password=secrets/mysql_root_password \
#      --from-file=replication_password=secrets/replication_password \
#      --from-file=db_password=secrets/db_password \
#      --from-literal=monitor_password="$(openssl rand -hex 16)"
#
#    Then tell Argo CD to ignore the fact that it did not create it — nothing
#    to do, actually: Argo only prunes resources it tracks.
#
#  Option B — the GitOps-correct way. Encrypt it so the ciphertext CAN live in
#  git and Argo CD can own it end to end. Pick one:
#
#    Sealed Secrets (bitnami-labs):
#      kubeseal --format yaml -n tasks-db < secret.yaml > sealed-secret.yaml
#      # commit sealed-secret.yaml — only the controller's private key opens it
#
#    External Secrets Operator (AWS Secrets Manager / GCP SM / Azure KV /
#    Vault). See external-secret.yaml.example next to this file.
#
#    SOPS + age (with the argocd-vault-plugin or the ksops plugin).
#
#  --------------------------------------------------------------------------
#  stringData is used (not data) so the values are plain text, not base64 —
#  Kubernetes encodes them on write.
# ============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: mysql-secrets
  namespace: tasks-db
  labels:
    app.kubernetes.io/part-of: task-manager
type: Opaque
stringData:
  # MySQL root — used by the init scripts, the readiness probes and the backup
  # CronJob (mysqldump runs as root).
  mysql_root_password: CHANGE_ME_root
  # The account the replica's IO thread authenticates with.
  replication_password: CHANGE_ME_repl
  # The application account ("appuser"). The SAME value must be in the
  # backend-secrets Secret in the tasks-app namespace — Secrets do not cross
  # namespaces. See k8s/production/apps/secrets.yaml.example.
  db_password: CHANGE_ME_app
  # ProxySQL's health-monitor account. In Compose this was hardcoded as
  # "monitor123" in proxysql/proxysql.cnf; here the config loader injects it
  # from this Secret at boot, so it is no longer a literal in git.
  monitor_password: CHANGE_ME_monitor
