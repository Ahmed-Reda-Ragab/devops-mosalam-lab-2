# ============================================================================
#  Application secrets. Same handling rules as the database ones — see
#  k8s/production/database/secrets.yaml.example for the Sealed Secrets /
#  External Secrets options.
#
#  ⚠️  DO NOT COMMIT A FILLED-IN COPY.
#
#  Quick start:
#    kubectl -n tasks-app create secret generic backend-secrets \
#      --from-file=db_password=secrets/db_password
#
#  Why it is duplicated across namespaces: a Secret is namespaced, and the
#  backend runs in tasks-app while MySQL runs in tasks-db. The value MUST match
#  db_password in the tasks-db/mysql-secrets Secret, or ProxySQL will reject the
#  backend with "Access denied for user 'appuser'". If keeping two copies in
#  sync bothers you, that is precisely the problem External Secrets Operator
#  solves: one ExternalSecret per namespace, both pointing at the same key in
#  AWS Secrets Manager / Vault.
# ============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
  namespace: tasks-app
  labels:
    app.kubernetes.io/name: backend
    app.kubernetes.io/part-of: task-manager
type: Opaque
stringData:
  # Mounted at /run/secrets/db_password. The backend's pydantic Settings reads
  # it from there (secrets_dir="/run/secrets" in backend/app/config.py), which
  # is why this is a FILE mount and not an env var — no code change needed.
  db_password: CHANGE_ME_app
