# ============================================================================
#  Monitoring secrets — replaces the Docker secrets grafana_admin_password and
#  telegram_token from compose/docker-compose.monitoring.yml.
#
#  ⚠️  DO NOT COMMIT A FILLED-IN COPY. See
#  k8s/production/database/secrets.yaml.example for the Sealed Secrets /
#  External Secrets options that let the encrypted form live in git.
#
#  Quick start:
#    kubectl -n monitoring create secret generic grafana-secrets \
#      --from-file=grafana_admin_password=secrets/grafana_admin_password
#
#    kubectl -n monitoring create secret generic alertmanager-secrets \
#      --from-file=telegram_token=secrets/telegram_token
# ============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: grafana-secrets
  namespace: monitoring
  labels:
    app.kubernetes.io/name: grafana
    app.kubernetes.io/part-of: task-manager
type: Opaque
stringData:
  # Read via GF_SECURITY_ADMIN_PASSWORD__FILE (note the DOUBLE underscore —
  # that is Grafana's file-provider convention, not a typo).
  grafana_admin_password: CHANGE_ME_grafana
---
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-secrets
  namespace: monitoring
  labels:
    app.kubernetes.io/name: alertmanager
    app.kubernetes.io/part-of: task-manager
type: Opaque
stringData:
  # Read via bot_token_file in alertmanager.yml.
  telegram_token: CHANGE_ME_telegram_bot_token
