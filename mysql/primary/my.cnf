[mysqld]
# ---- Server identity ----
server-id                = 1
bind-address             = 0.0.0.0

# ---- Binary logging / GTID (required to act as a replication source) ----
log_bin                  = mysql-bin
binlog_format            = ROW
gtid_mode                = ON
enforce_gtid_consistency = ON
log_slave_updates        = ON

# ---- Durability (safe defaults for a primary) ----
sync_binlog                    = 1
innodb_flush_log_at_trx_commit = 1

# ---- Misc ----
skip-name-resolve
# Fixed socket path so the init scripts and healthcheck are deterministic
socket                   = /var/lib/mysql/mysql.sock

[client]
socket                   = /var/lib/mysql/mysql.sock
