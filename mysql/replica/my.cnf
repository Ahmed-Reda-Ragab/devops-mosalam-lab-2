[mysqld]
# ---- Server identity (must differ from the primary) ----
server-id                = 2
bind-address             = 0.0.0.0

# ---- Relay / binary logging + GTID ----
relay_log                = relay-bin
log_bin                  = mysql-bin
gtid_mode                = ON
enforce_gtid_consistency = ON
log_slave_updates        = ON

# ---- Read-only replica ----
# read_only blocks writes from regular users (root & the replication threads
# bypass it, which is exactly what we want).
read_only                = ON
# NOTE: super_read_only is intentionally NOT set here. If it were, MySQL's very
# first container initialization (creating root / system users) would fail with
# "--super-read-only option so it cannot execute this statement". Instead the
# replica init script enables it at runtime via `SET PERSIST super_read_only=ON`,
# which persists across restarts.

# ---- Misc ----
skip-name-resolve
socket                   = /var/lib/mysql/mysql.sock

[client]
socket                   = /var/lib/mysql/mysql.sock
