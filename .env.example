# -----------------------------------------------------------------------------
# Non-secret configuration. Copy this file to .env and adjust as needed:
#     cp .env.example .env
#
# Docker Compose auto-loads the root .env, so these values are used both for
# ${VAR} substitution in docker-compose.yml AND injected into the backend
# container (via env_file).
#
# NOTE: passwords / tokens are NOT here — they live in ./secrets/* as Docker
# secrets. See ROADMAP.md.
# -----------------------------------------------------------------------------

# Database connection (shared by the db and backend services)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=appdb
DB_USERNAME=appuser
